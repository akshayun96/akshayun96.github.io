---
import '../styles/global.css';
import { content, otherLang } from '../content.js';

// path: the part of the URL after /<lang>/, used to link the same page in the other language
const { lang, title, path = '' } = Astro.props;
const t = content[lang];
const other = otherLang(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(`/${lang}/${path}`, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(`/${lang}/${path}`, Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(`/${other}/${path}`, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={`/${lang}/`}>{t.hero.name}</a>
        <nav aria-label="Main">
          <ul>
            {Object.entries(t.ui.nav).map(([id, label]) => (
              <li><a href={`/${lang}/#${id}`}>{label}</a></li>
            ))}
            <li>
              <a class="lang-switch" href={`/${other}/${path}`} hreflang={other} lang={other} aria-label={t.ui.switchLanguageLabel}>
                {other.toUpperCase()}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {t.hero.name}</span>
        <a href={`/${lang}/impressum/`}>{t.ui.legal}</a>
      </div>
    </footer>
  </body>
</html>
